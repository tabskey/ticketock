# Copy this file to .env and set a real secret before running anything
# beyond local development. .env is git-ignored on purpose — never commit
# real secrets.

# Signing key for JWTs (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
